[
  {
    "id": "discipline-both",
    "sources": [
      "office-kinds-law-79",
      "office-kinds-local-law-70",
      "office-kinds-law-80"
    ],
    "branches": [
      {
        "label": "징계 여섯 가지",
        "items": [
          {
            "source": "office-kinds-law-79",
            "text": "공무원 징계는 파면, 해임, 강등, 정직, 감봉, 견책 여섯 가지예요. 국가공무원은 국가공무원법 제79조에 정해져 있어요.",
            "requires": [
              "파면ㆍ해임ㆍ강등ㆍ정직ㆍ감봉ㆍ견책",
              "구분한다"
            ]
          },
          {
            "source": "office-kinds-local-law-70",
            "text": "지방공무원도 지방공무원법 제70조에서 같은 여섯 가지로 나눠요.",
            "requires": [
              "파면ㆍ해임ㆍ강등ㆍ정직ㆍ감봉 및 견책으로 구분한다"
            ]
          }
        ]
      },
      {
        "label": "종류별 효력",
        "items": [
          {
            "source": "office-kinds-law-80",
            "text": "강등: 1계급 아래로 내리고 3개월간 직무에 종사하지 못하며 그동안 보수를 전액 감해요(국가공무원법 제80조).",
            "requires": [
              "1계급 아래로 직급을 내리고",
              "3개월간 직무에 종사하지 못하며 그 기간 중 보수는 전액을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "정직: 1개월 이상 3개월 이하 기간 동안 직무에 종사하지 못하고 보수를 전액 감해요.",
            "requires": [
              "정직은 1개월 이상 3개월 이하의 기간으로",
              "보수는 전액을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "감봉: 1개월 이상 3개월 이하 기간 동안 보수의 3분의 1을 감해요.",
            "requires": [
              "감봉은 1개월 이상 3개월 이하의 기간 동안 보수의 3분의 1을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "견책: 지난 잘못을 훈계하고 뉘우치게 해요.",
            "requires": [
              "훈계하고 회개하게 한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "징계를 받으면 정해진 기간 동안 승진임용이나 승급을 할 수 없어요. 강등·정직·감봉은 휴직 중에는 집행이 정지돼요.",
            "requires": [
              "승진임용 또는 승급할 수 없다",
              "휴직기간 중에는 그 집행을 정지한다"
            ]
          }
        ]
      }
    ]
  },
