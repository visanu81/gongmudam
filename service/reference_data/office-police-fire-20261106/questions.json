[
  {
    "id": "absence-police",
    "sources": [
      "office-pf-pl1",
      "office-pf-pl36",
      "office-absence-national-71",
      "office-absence-national-72",
      "office-pf-pl29",
      "office-absence-national-73"
    ],
    "branches": [
      {
        "label": "적용 법령",
        "items": [
          {
            "source": "office-pf-pl1",
            "text": "경찰공무원법은 국가공무원법에 대한 특례를 정한 법이에요(제1조).",
            "requires": [
              "「국가공무원법」에 대한 특례를 규정함을 목적으로"
            ]
          },
          {
            "source": "office-pf-pl36",
            "text": "적용하지 않는 국가공무원법 조문에 휴직(제71~73조)은 들어 있지 않아요. 그래서 휴직은 국가공무원법 제71~73조를 따르고, 경찰공무원법이 따로 정한 특례만 달라요(경찰공무원법 제36조).",
            "requires": [
              "제73조의4",
              "제76조제2항부터 제5항까지의 규정을 적용하지 아니하며"
            ]
          }
        ]
      },
      {
        "label": "휴직 종류",
        "items": [
          {
            "source": "office-absence-national-71",
            "text": "본인 의사와 상관없이 명하는 휴직은 질병, 병역, 생사불명, 법률상 의무 수행, 노조 전임이에요.",
            "requires": [
              "본인의 의사에도 불구하고 휴직을 명하여야 한다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "본인이 원해서 하는 휴직은 고용, 유학, 연수, 육아, 가족돌봄, 배우자 동반, 자기개발이에요.",
            "requires": [
              "휴직을 원하면 휴직을 명할 수 있다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "임기제공무원은 질병·병역·육아 휴직만 적용돼요.",
            "requires": [
              "제1항제1호ㆍ제3호 및 제2항제4호에 한정하여"
            ]
          }
        ]
      },
      {
        "label": "육아 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "자녀를 키우거나 임신·출산으로 쉬는 휴직은 자녀 1명에 3년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "자녀 1명에 대하여 3년 이내로 한다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "12세 이하 또는 초등학교 6학년 이하 자녀가 대상이에요. 원하면 특별한 사정이 없는 한 휴직을 명해야 하고, 이를 이유로 인사에 불리하게 대우하면 안 돼요.",
            "requires": [
              "12세 이하 또는 초등학교 6학년 이하의 자녀를 양육",
              "특별한 사정이 없으면 휴직을 명하여야 한다",
              "휴직을 이유로 인사에 불리한 처우를 하여서는 아니 된다"
            ]
          }
        ]
      },
      {
        "label": "질병 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "질병 휴직은 1년 이내이고, 부득이하면 1년 더 연장할 수 있어요. 요양급여 대상인 질병·부상이면 3년 이내이고, 의학적 소견 등에 따라 2년 더 연장할 수 있어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "휴직기간은 1년 이내로 하되, 부득이한 경우 1년의 범위에서 연장할 수 있다",
              "휴직기간은 3년 이내로 하되",
              "2년의 범위에서 연장할 수 있다"
            ]
          },
          {
            "source": "office-pf-pl29",
            "text": "경찰공무원이 「공무원 재해보상법」 제5조 제1호 각 목의 직무를 수행하다가 공무상 질병·부상을 입어 휴직하면 5년 이내이고, 의학적 소견 등에 따라 3년 더 연장할 수 있어요(경찰공무원법 제29조).",
            "requires": [
              "제5조제1호 각 목에 해당하는 직무를 수행하다가",
              "5년 이내로 하되",
              "3년의 범위에서 연장할 수 있다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "신체·정신상의 장애로 장기 요양이 필요하면 본인 의사와 상관없이 휴직을 명해요.",
            "requires": [
              "신체ㆍ정신상의 장애로 장기 요양이 필요할 때",
              "본인의 의사에도 불구하고 휴직을 명하여야 한다"
            ]
          }
        ]
      },
      {
        "label": "가족돌봄 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "가족을 부양하거나 돌보는 휴직은 1년 이내이고, 재직 기간 중 총 3년을 넘을 수 없어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "1년 이내로 하되, 재직 기간 중 총 3년을 넘을 수 없다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "대상은 조부모, 부모(배우자의 부모 포함), 배우자, 자녀, 손자녀예요. 조부모·손자녀는 본인 외에 돌볼 사람이 없는 등 요건을 갖춰야 해요.",
            "requires": [
              "조부모, 부모(배우자의 부모를 포함한다), 배우자, 자녀 또는 손자녀를 부양하거나 돌보기 위하여",
              "본인 외에 돌볼 사람이 없는 등"
            ]
          }
        ]
      },
      {
        "label": "유학 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "유학 휴직은 3년 이내이고, 부득이하면 2년 더 연장할 수 있어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "3년 이내로 하되, 부득이한 경우에는 2년의 범위에서 연장할 수 있다"
            ]
          }
        ]
      },
      {
        "label": "배우자 동반 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "외국에서 근무·유학·연수하는 배우자를 동반하는 휴직은 3년 이내이고, 부득이하면 2년 더 연장할 수 있어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "제6호에 따른 휴직 기간은 3년 이내로 하되, 부득이한 경우에는 2년의 범위에서 연장할 수 있다"
            ]
          }
        ]
      },
      {
        "label": "연수 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "지정된 연구기관·교육기관 연수 휴직은 2년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "제3호에 따른 휴직 기간은 2년 이내로 한다"
            ]
          },
          {
            "source": "office-pf-pl36",
            "text": "연수 기관은 경찰청장 또는 해양경찰청장이 지정해요(경찰공무원법 제36조).",
            "requires": [
              "제71조제2항제3호 중 “중앙인사관장기관의 장”은 “경찰청장 또는 해양경찰청장”으로 본다"
            ]
          }
        ]
      },
      {
        "label": "고용 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "국제기구·외국 기관·대학 등에 임시로 채용되는 휴직은 그 채용 기간이고, 민간기업이나 그 밖의 기관은 3년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "그 채용 기간으로 한다",
              "3년 이내로 한다"
            ]
          }
        ]
      },
      {
        "label": "자기개발 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "일정 기간 재직한 공무원의 직무 연구·자기개발 휴직은 1년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "제7호에 따른 휴직 기간은 1년 이내로 한다"
            ]
          }
        ]
      },
      {
        "label": "병역 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "병역 복무나 법률상 의무 수행으로 직무를 떠나는 휴직은 그 복무 기간이 끝날 때까지예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "그 복무 기간이 끝날 때까지로 한다"
            ]
          }
        ]
      },
      {
        "label": "생사불명 휴직",
        "items": [
          {
            "source": "office-pf-pl29",
            "text": "천재지변·전시 등으로 생사나 소재가 불명확해진 경찰공무원의 휴직은 법원의 실종선고를 받는 날까지예요(경찰공무원법 제29조).",
            "requires": [
              "제71조제1항제4호",
              "법원의 실종선고를 받는 날까지"
            ]
          }
        ]
      },
      {
        "label": "노조 전임 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "노동조합 전임자로 종사하는 휴직은 그 전임 기간이에요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "그 전임 기간으로 한다"
            ]
          }
        ]
      },
      {
        "label": "신분과 복직",
        "items": [
          {
            "source": "office-absence-national-73",
            "text": "휴직 중에는 공무원 신분은 유지되지만 직무에는 종사하지 못해요.",
            "requires": [
              "신분은 보유하나 직무에 종사하지 못한다"
            ]
          },
          {
            "source": "office-absence-national-73",
            "text": "휴직 사유가 없어지면 30일 이내에 임용권자에게 신고해야 하고, 임용권자는 지체 없이 복직을 명해요.",
            "requires": [
              "그 사유가 없어지면 30일 이내에"
            ]
          },
          {
            "source": "office-absence-national-73",
            "text": "휴직 기간이 끝나고 30일 이내에 복귀 신고를 하면 당연히 복직돼요.",
            "requires": [
              "30일 이내에 복귀 신고를 하면 당연히 복직된다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "discipline-police",
    "sources": [
      "office-pf-pl1",
      "office-pf-pl36",
      "office-kinds-law-79",
      "office-kinds-law-80"
    ],
    "branches": [
      {
        "label": "적용 법령",
        "items": [
          {
            "source": "office-pf-pl1",
            "text": "경찰공무원법은 국가공무원법에 대한 특례를 정한 법이에요(제1조).",
            "requires": [
              "「국가공무원법」에 대한 특례를 규정함을 목적으로"
            ]
          },
          {
            "source": "office-pf-pl36",
            "text": "적용하지 않는 조문에 징계의 종류·효력(제79·80조)은 들어 있지 않아요.",
            "requires": [
              "제73조의4",
              "제76조제2항부터 제5항까지의 규정을 적용하지 아니하며"
            ]
          }
        ]
      },
      {
        "label": "징계 여섯 가지",
        "items": [
          {
            "source": "office-kinds-law-79",
            "text": "경찰공무원 징계도 국가공무원법에 따라 파면, 해임, 강등, 정직, 감봉, 견책 여섯 가지예요(국가공무원법 제79조).",
            "requires": [
              "파면ㆍ해임ㆍ강등ㆍ정직ㆍ감봉ㆍ견책",
              "구분한다"
            ]
          }
        ]
      },
      {
        "label": "종류별 효력",
        "items": [
          {
            "source": "office-kinds-law-80",
            "text": "강등: 1계급 아래로 내리고 3개월간 직무에 종사하지 못하며 그동안 보수를 전액 감해요(국가공무원법 제80조).",
            "requires": [
              "1계급 아래로 직급을 내리고",
              "3개월간 직무에 종사하지 못하며 그 기간 중 보수는 전액을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "정직: 1개월 이상 3개월 이하 기간 동안 직무에 종사하지 못하고 보수를 전액 감해요.",
            "requires": [
              "정직은 1개월 이상 3개월 이하의 기간으로",
              "보수는 전액을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "감봉: 1개월 이상 3개월 이하 기간 동안 보수의 3분의 1을 감해요.",
            "requires": [
              "감봉은 1개월 이상 3개월 이하의 기간 동안 보수의 3분의 1을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "견책: 지난 잘못을 훈계하고 뉘우치게 해요.",
            "requires": [
              "훈계하고 회개하게 한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "징계를 받으면 정해진 기간 동안 승진임용이나 승급을 할 수 없어요. 강등·정직·감봉은 휴직 중에는 집행이 정지돼요.",
            "requires": [
              "승진임용 또는 승급할 수 없다",
              "휴직기간 중에는 그 집행을 정지한다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "leave-types-police",
    "sources": [
      "office-leave-national-14",
      "office-leave-national-15",
      "office-leave-national-18",
      "office-leave-national-19",
      "office-leave-national-20",
      "office-pf-ps20",
      "office-pf-ps18"
    ],
    "branches": [
      {
        "label": "휴가 네 가지",
        "items": [
          {
            "source": "office-leave-national-14",
            "text": "경찰공무원 휴가도 국가공무원 복무규정에 따라 연가, 병가, 공가, 특별휴가 네 가지예요.",
            "requires": [
              "공무원의 휴가는 연가",
              "병가, 공가",
              "및 특별휴가로 구분한다"
            ]
          },
          {
            "source": "office-leave-national-15",
            "text": "연가: 재직기간에 따라 일수가 정해져 있어요(국가공무원 복무규정 제15조).",
            "requires": [
              "공무원의 재직기간별 연가 일수는 다음과 같다"
            ]
          },
          {
            "source": "office-leave-national-18",
            "text": "병가: 질병·부상이나 감염병이면 연 60일, 공무상 질병·부상이면 연 180일 범위예요. 연 6일을 넘으면 진단서를 붙여요(국가공무원 복무규정 제18조).",
            "requires": [
              "연 60일의 범위에서 병가를 승인할 수 있",
              "연 180일의 범위",
              "연간 6일을 초과하는 경우에는 의사의 진단서를 첨부하여야 한다"
            ]
          },
          {
            "source": "office-leave-national-19",
            "text": "공가: 병역 소집·훈련, 투표, 승진시험, 건강검진, 헌혈, 천재지변으로 출근이 불가능할 때 등 정해진 사유에 필요한 기간만큼 받아요(국가공무원 복무규정 제19조).",
            "requires": [
              "직접 필요한 기간 또는 시간을 공가로 승인해야 한다",
              "법률에 따라 투표에 참가할 때",
              "헌혈에 참가할 때"
            ]
          }
        ]
      },
      {
        "label": "특별휴가 세부 종류",
        "items": [
          {
            "source": "office-leave-national-20",
            "text": "특별휴가(국가공무원 복무규정 제20조)는 경조사, 출산, 여성보건, 모성보호시간, 육아시간, 수업, 재난 피해·자원봉사, 유산·사산, 난임치료시술, 포상, 가족돌봄, 임신검진, 임신검진 동행, 심리안정, 장기재직 휴가가 있어요.",
            "requires": [
              "경조사",
              "출산휴가",
              "여성보건휴가",
              "모성보호시간",
              "육아시간",
              "수업휴가",
              "재난으로 피해",
              "유산휴가",
              "난임치료시술휴가",
              "포상휴가",
              "가족돌봄휴가",
              "임신검진휴가",
              "임신검진 동행휴가",
              "심리안정",
              "장기재직"
            ]
          }
        ]
      },
      {
        "label": "경찰공무원 별도 규정",
        "items": [
          {
            "source": "office-pf-ps20",
            "text": "경찰공무원 복무규정에 없는 내용은 국가공무원 복무규정을 적용해요(경찰공무원 복무규정 제20조).",
            "requires": [
              "이 영에서 규정한 사항 외에는",
              "「국가공무원 복무규정」을 적용한다"
            ]
          },
          {
            "source": "office-pf-ps18",
            "text": "포상휴가: 경찰기관의 장이 1회 10일 이내로 허가할 수 있고, 연가일수에 들어가지 않아요(경찰공무원 복무규정 제18조).",
            "requires": [
              "1회10일이내의 포상휴가",
              "연가일수에 산입하지 아니한다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "absence-fire",
    "sources": [
      "office-pf-fl1",
      "office-pf-fl33",
      "office-absence-national-71",
      "office-absence-national-72",
      "office-pf-fl24-2",
      "office-absence-national-73"
    ],
    "branches": [
      {
        "label": "적용 법령",
        "items": [
          {
            "source": "office-pf-fl1",
            "text": "소방공무원법은 국가공무원법에 대한 특례를 정한 법이에요(제1조).",
            "requires": [
              "「국가공무원법」에 대한 특례를 규정하는 것을 목적으로"
            ]
          },
          {
            "source": "office-pf-fl33",
            "text": "휴직 조문은 달리 정하지 않아 국가공무원법 제71~73조를 따르고, 소방공무원법이 따로 정한 특례만 달라요(소방공무원법 제33조·제24조의2).",
            "requires": [
              "「국가공무원법」을 소방공무원에게 적용할 때에는"
            ]
          }
        ]
      },
      {
        "label": "휴직 종류",
        "items": [
          {
            "source": "office-absence-national-71",
            "text": "본인 의사와 상관없이 명하는 휴직은 질병, 병역, 생사불명, 법률상 의무 수행, 노조 전임이에요.",
            "requires": [
              "본인의 의사에도 불구하고 휴직을 명하여야 한다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "본인이 원해서 하는 휴직은 고용, 유학, 연수, 육아, 가족돌봄, 배우자 동반, 자기개발이에요.",
            "requires": [
              "휴직을 원하면 휴직을 명할 수 있다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "임기제공무원은 질병·병역·육아 휴직만 적용돼요.",
            "requires": [
              "제1항제1호ㆍ제3호 및 제2항제4호에 한정하여"
            ]
          }
        ]
      },
      {
        "label": "육아 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "자녀를 키우거나 임신·출산으로 쉬는 휴직은 자녀 1명에 3년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "자녀 1명에 대하여 3년 이내로 한다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "12세 이하 또는 초등학교 6학년 이하 자녀가 대상이에요. 원하면 특별한 사정이 없는 한 휴직을 명해야 하고, 이를 이유로 인사에 불리하게 대우하면 안 돼요.",
            "requires": [
              "12세 이하 또는 초등학교 6학년 이하의 자녀를 양육",
              "특별한 사정이 없으면 휴직을 명하여야 한다",
              "휴직을 이유로 인사에 불리한 처우를 하여서는 아니 된다"
            ]
          }
        ]
      },
      {
        "label": "질병 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "질병 휴직은 1년 이내이고, 부득이하면 1년 더 연장할 수 있어요. 요양급여 대상인 질병·부상이면 3년 이내이고, 의학적 소견 등에 따라 2년 더 연장할 수 있어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "휴직기간은 1년 이내로 하되, 부득이한 경우 1년의 범위에서 연장할 수 있다",
              "휴직기간은 3년 이내로 하되",
              "2년의 범위에서 연장할 수 있다"
            ]
          },
          {
            "source": "office-pf-fl24-2",
            "text": "소방공무원이 「공무원 재해보상법」 제5조 제2호 각 목의 직무를 수행하다가 공무상 질병·부상을 입어 휴직하면 5년 이내이고, 의학적 소견 등에 따라 3년 더 연장할 수 있어요(소방공무원법 제24조의2).",
            "requires": [
              "제5조제2호 각 목에 해당하는 직무를 수행하다가",
              "5년 이내로 하되",
              "3년의 범위에서 연장할 수 있다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "신체·정신상의 장애로 장기 요양이 필요하면 본인 의사와 상관없이 휴직을 명해요.",
            "requires": [
              "신체ㆍ정신상의 장애로 장기 요양이 필요할 때",
              "본인의 의사에도 불구하고 휴직을 명하여야 한다"
            ]
          }
        ]
      },
      {
        "label": "가족돌봄 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "가족을 부양하거나 돌보는 휴직은 1년 이내이고, 재직 기간 중 총 3년을 넘을 수 없어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "1년 이내로 하되, 재직 기간 중 총 3년을 넘을 수 없다"
            ]
          },
          {
            "source": "office-absence-national-71",
            "text": "대상은 조부모, 부모(배우자의 부모 포함), 배우자, 자녀, 손자녀예요. 조부모·손자녀는 본인 외에 돌볼 사람이 없는 등 요건을 갖춰야 해요.",
            "requires": [
              "조부모, 부모(배우자의 부모를 포함한다), 배우자, 자녀 또는 손자녀를 부양하거나 돌보기 위하여",
              "본인 외에 돌볼 사람이 없는 등"
            ]
          }
        ]
      },
      {
        "label": "유학 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "유학 휴직은 3년 이내이고, 부득이하면 2년 더 연장할 수 있어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "3년 이내로 하되, 부득이한 경우에는 2년의 범위에서 연장할 수 있다"
            ]
          }
        ]
      },
      {
        "label": "배우자 동반 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "외국에서 근무·유학·연수하는 배우자를 동반하는 휴직은 3년 이내이고, 부득이하면 2년 더 연장할 수 있어요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "제6호에 따른 휴직 기간은 3년 이내로 하되, 부득이한 경우에는 2년의 범위에서 연장할 수 있다"
            ]
          }
        ]
      },
      {
        "label": "연수 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "지정된 연구기관·교육기관 연수 휴직은 2년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "제3호에 따른 휴직 기간은 2년 이내로 한다"
            ]
          },
          {
            "source": "office-pf-fl33",
            "text": "연수 기관은 소방청장이 지정해요(소방공무원법 제33조).",
            "requires": [
              "제71조제2항제3호 중 “중앙인사관장기관의 장”은 “소방청장”으로 본다"
            ]
          }
        ]
      },
      {
        "label": "고용 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "국제기구·외국 기관·대학 등에 임시로 채용되는 휴직은 그 채용 기간이고, 민간기업이나 그 밖의 기관은 3년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "그 채용 기간으로 한다",
              "3년 이내로 한다"
            ]
          }
        ]
      },
      {
        "label": "자기개발 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "일정 기간 재직한 공무원의 직무 연구·자기개발 휴직은 1년 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "제7호에 따른 휴직 기간은 1년 이내로 한다"
            ]
          }
        ]
      },
      {
        "label": "병역 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "병역 복무나 법률상 의무 수행으로 직무를 떠나는 휴직은 그 복무 기간이 끝날 때까지예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "그 복무 기간이 끝날 때까지로 한다"
            ]
          }
        ]
      },
      {
        "label": "생사불명 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "천재지변·전시 등으로 생사나 소재가 불명확해진 경우의 휴직은 3개월 이내예요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "3개월 이내로 한다"
            ]
          }
        ]
      },
      {
        "label": "노조 전임 휴직",
        "items": [
          {
            "source": "office-absence-national-72",
            "text": "노동조합 전임자로 종사하는 휴직은 그 전임 기간이에요. 근거는 국가공무원법 제72조예요.",
            "requires": [
              "그 전임 기간으로 한다"
            ]
          }
        ]
      },
      {
        "label": "신분과 복직",
        "items": [
          {
            "source": "office-absence-national-73",
            "text": "휴직 중에는 공무원 신분은 유지되지만 직무에는 종사하지 못해요.",
            "requires": [
              "신분은 보유하나 직무에 종사하지 못한다"
            ]
          },
          {
            "source": "office-absence-national-73",
            "text": "휴직 사유가 없어지면 30일 이내에 임용권자에게 신고해야 하고, 임용권자는 지체 없이 복직을 명해요.",
            "requires": [
              "그 사유가 없어지면 30일 이내에"
            ]
          },
          {
            "source": "office-absence-national-73",
            "text": "휴직 기간이 끝나고 30일 이내에 복귀 신고를 하면 당연히 복직돼요.",
            "requires": [
              "30일 이내에 복귀 신고를 하면 당연히 복직된다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "discipline-fire",
    "sources": [
      "office-pf-fl1",
      "office-pf-fl33",
      "office-kinds-law-79",
      "office-kinds-law-80"
    ],
    "branches": [
      {
        "label": "적용 법령",
        "items": [
          {
            "source": "office-pf-fl1",
            "text": "소방공무원법은 국가공무원법에 대한 특례를 정한 법이에요(제1조).",
            "requires": [
              "「국가공무원법」에 대한 특례를 규정하는 것을 목적으로"
            ]
          },
          {
            "source": "office-pf-fl33",
            "text": "징계의 종류·효력은 달리 정하지 않아 국가공무원법 제79·80조를 따라요.",
            "requires": [
              "「국가공무원법」을 소방공무원에게 적용할 때에는"
            ]
          }
        ]
      },
      {
        "label": "징계 여섯 가지",
        "items": [
          {
            "source": "office-kinds-law-79",
            "text": "소방공무원 징계도 국가공무원법에 따라 파면, 해임, 강등, 정직, 감봉, 견책 여섯 가지예요(국가공무원법 제79조).",
            "requires": [
              "파면ㆍ해임ㆍ강등ㆍ정직ㆍ감봉ㆍ견책",
              "구분한다"
            ]
          }
        ]
      },
      {
        "label": "종류별 효력",
        "items": [
          {
            "source": "office-kinds-law-80",
            "text": "강등: 1계급 아래로 내리고 3개월간 직무에 종사하지 못하며 그동안 보수를 전액 감해요(국가공무원법 제80조).",
            "requires": [
              "1계급 아래로 직급을 내리고",
              "3개월간 직무에 종사하지 못하며 그 기간 중 보수는 전액을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "정직: 1개월 이상 3개월 이하 기간 동안 직무에 종사하지 못하고 보수를 전액 감해요.",
            "requires": [
              "정직은 1개월 이상 3개월 이하의 기간으로",
              "보수는 전액을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "감봉: 1개월 이상 3개월 이하 기간 동안 보수의 3분의 1을 감해요.",
            "requires": [
              "감봉은 1개월 이상 3개월 이하의 기간 동안 보수의 3분의 1을 감한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "견책: 지난 잘못을 훈계하고 뉘우치게 해요.",
            "requires": [
              "훈계하고 회개하게 한다"
            ]
          },
          {
            "source": "office-kinds-law-80",
            "text": "징계를 받으면 정해진 기간 동안 승진임용이나 승급을 할 수 없어요. 강등·정직·감봉은 휴직 중에는 집행이 정지돼요.",
            "requires": [
              "승진임용 또는 승급할 수 없다",
              "휴직기간 중에는 그 집행을 정지한다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "leave-types-fire",
    "sources": [
      "office-leave-national-14",
      "office-leave-national-15",
      "office-leave-national-18",
      "office-pf-fs8-2",
      "office-leave-national-20",
      "office-pf-fs10",
      "office-pf-fs9",
      "office-pf-fs11"
    ],
    "branches": [
      {
        "label": "휴가 네 가지",
        "items": [
          {
            "source": "office-leave-national-14",
            "text": "소방공무원 휴가도 국가공무원 복무규정을 준용해 연가, 병가, 공가, 특별휴가 네 가지예요.",
            "requires": [
              "공무원의 휴가는 연가",
              "병가, 공가",
              "및 특별휴가로 구분한다"
            ]
          },
          {
            "source": "office-leave-national-15",
            "text": "연가: 재직기간에 따라 일수가 정해져 있어요(국가공무원 복무규정 제15조).",
            "requires": [
              "공무원의 재직기간별 연가 일수는 다음과 같다"
            ]
          },
          {
            "source": "office-leave-national-18",
            "text": "병가: 질병·부상이나 감염병이면 연 60일, 공무상 질병·부상이면 연 180일 범위예요. 연 6일을 넘으면 진단서를 붙여요(국가공무원 복무규정 제18조).",
            "requires": [
              "연 60일의 범위에서 병가를 승인할 수 있",
              "연 180일의 범위",
              "연간 6일을 초과하는 경우에는 의사의 진단서를 첨부하여야 한다"
            ]
          },
          {
            "source": "office-pf-fs8-2",
            "text": "공가: 병역 소집·훈련, 국회·법원 등 소환, 투표, 승진·전직시험, 원격지 전보 부임, 건강검진·특수건강진단, 헌혈 등 정해진 사유에 필요한 기간만큼 받아요(소방공무원 복무규정 제8조의2).",
            "requires": [
              "직접 필요한 기간을 공가로 승인해야 한다",
              "특수건강진단",
              "헌혈에 참가할 때"
            ]
          }
        ]
      },
      {
        "label": "특별휴가 세부 종류",
        "items": [
          {
            "source": "office-leave-national-20",
            "text": "특별휴가(국가공무원 복무규정 제20조)는 경조사, 출산, 여성보건, 모성보호시간, 육아시간, 수업, 재난 피해·자원봉사, 유산·사산, 난임치료시술, 포상, 가족돌봄, 임신검진, 임신검진 동행, 심리안정, 장기재직 휴가가 있어요.",
            "requires": [
              "경조사",
              "출산휴가",
              "여성보건휴가",
              "모성보호시간",
              "육아시간",
              "수업휴가",
              "재난으로 피해",
              "유산휴가",
              "난임치료시술휴가",
              "포상휴가",
              "가족돌봄휴가",
              "임신검진휴가",
              "임신검진 동행휴가",
              "심리안정",
              "장기재직"
            ]
          }
        ]
      },
      {
        "label": "소방공무원 별도 규정",
        "items": [
          {
            "source": "office-pf-fs10",
            "text": "소방공무원 복무규정에 없는 내용은 국가공무원 복무규정을 준용해요(소방공무원 복무규정 제10조).",
            "requires": [
              "이 영에서 규정한 사항 외에는",
              "「국가공무원 복무규정」을 준용한다"
            ]
          },
          {
            "source": "office-pf-fs9",
            "text": "포상휴가: 소방기관의 장이 1회 10일 이내로 줄 수 있고, 연가일수에 들어가지 않아요(소방공무원 복무규정 제9조).",
            "requires": [
              "1회 10일 이내의 포상휴가",
              "포상휴가기간은 연가일수에 산입"
            ]
          },
          {
            "source": "office-pf-fs11",
            "text": "시·도 소속 소방공무원의 특별휴가는 복무규정에 없는 사항이면 소속 지방자치단체 조례를 적용하고, 장기재직휴가는 조례를 적용해요(소방공무원 복무규정 제11조).",
            "requires": [
              "소속 지방자치단체의 특별휴가에 관한 조례를 적용한다",
              "소속 지방자치단체의 장기재직휴가에 관한 조례를 적용한다"
            ]
          }
        ]
      }
    ]
  }
]
