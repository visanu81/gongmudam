[
  {
    "id": "privacy-collect",
    "title": "명단·연락처 수집",
    "sources": [
      "office-privacy-art15",
      "office-privacy-art16"
    ],
    "branches": [
      {
        "label": "수집 전에 확인해요",
        "items": [
          {
            "source": "office-privacy-art15",
            "text": "명단·연락처를 받기 전에 수집 목적과 법적 근거를 확인해요. 동의 외에도 법령상 의무·공공기관 소관 업무 등 근거가 있으므로, 무조건 동의만 받으면 된다고 판단하지 않아요.",
            "requires": [
              "다음 각 호의 어느 하나",
              "정보주체의 동의",
              "공공기관이 법령 등에서 정하는 소관 업무"
            ]
          },
          {
            "source": "office-privacy-art16",
            "text": "목적에 필요한 최소한의 항목만 받아요. 교육 운영에 전화번호가 꼭 필요한지 확인하고, 필요하지 않은 항목까지 관행적으로 수집하지 않아요.",
            "requires": [
              "그 목적에 필요한 최소한의 개인정보",
              "입증책임은 개인정보처리자가 부담"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "privacy-share",
    "title": "다른 기관에 명단 제공",
    "sources": [
      "office-privacy-art17",
      "office-privacy-art18"
    ],
    "branches": [
      {
        "label": "보내기 전에 확인해요",
        "items": [
          {
            "source": "office-privacy-art17",
            "text": "다른 기관에 보낸다고 자동으로 허용되는 것은 아니에요. 받는 기관·목적·항목을 정리하고 제3자 제공 근거와 조건을 확인해요. 가림 처리만으로 제공 근거 확인을 대신하지 않아요.",
            "requires": [
              "제3자에게 제공(공유를 포함한다",
              "정보주체의 동의를 받은 경우",
              "수집한 목적 범위",
              "합리적으로 관련된 범위"
            ]
          },
          {
            "source": "office-privacy-art18",
            "text": "원래 수집 목적을 벗어나면 별도의 목적 외 이용·제공 요건을 확인해요. 법률의 특별 규정·별도 동의 등 예외와 권리 침해 우려를 함께 검토해야 해요.",
            "requires": [
              "범위를 초과하여",
              "별도의 동의",
              "다른 법률에 특별한 규정",
              "부당하게 침해할 우려"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "privacy-delete",
    "title": "명단 보관·파기",
    "sources": [
      "office-privacy-art21"
    ],
    "branches": [
      {
        "label": "삭제 전에 보존 의무부터 확인해요",
        "items": [
          {
            "source": "office-privacy-art21",
            "text": "보유기간이 지났거나 처리 목적이 달성되어 불필요해지면 지체 없이 파기하는 것이 원칙이에요. 다만 다른 법령에 따라 보존해야 하는 자료는 예외이므로, 교육 종료만으로 바로 삭제하지 말고 해당 보존 의무를 확인해요.",
            "requires": [
              "보유기간의 경과",
              "처리 목적 달성",
              "다른 법령에 따라 보존하여야 하는 경우"
            ]
          },
          {
            "source": "office-privacy-art21",
            "text": "법령 때문에 보존하는 개인정보는 다른 개인정보와 분리해 관리해요. 파기할 때는 복구·재생되지 않도록 해야 하며, 구체적 보유기간과 파기 절차는 기관 기준·관계 법령을 추가 확인해요.",
            "requires": [
              "분리하여서 저장ㆍ관리",
              "복구 또는 재생되지 아니하도록",
              "파기방법 및 절차"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "privacy-rrn",
    "title": "주민등록번호 수집",
    "sources": [
      "office-privacy-art24-2"
    ],
    "branches": [
      {
        "label": "동의만으로 수집하지 않아요",
        "items": [
          {
            "source": "office-privacy-art24-2",
            "text": "주민등록번호는 일반 개인정보와 별도의 제한이 있어요. 동의서만 받았다는 이유로 수집하지 말고, 법령의 구체적 허용 등 제24조의2 예외에 해당하는지 확인해요.",
            "requires": [
              "경우를 제외하고는 주민등록번호를 처리할 수 없다",
              "구체적으로 주민등록번호의 처리를 요구하거나 허용한 경우"
            ]
          },
          {
            "source": "office-privacy-art24-2",
            "text": "적법하게 처리하는 경우에도 암호화 등 안전한 보관 조치가 필요해요. 실제 수집 근거와 기관의 처리 절차를 담당자에게 확인해요.",
            "requires": [
              "암호화 조치를 통하여 안전하게 보관"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "privacy-security",
    "title": "개인정보 안전조치",
    "sources": [
      "office-privacy-art29"
    ],
    "branches": [
      {
        "label": "안전하게 관리해요",
        "items": [
          {
            "source": "office-privacy-art29",
            "text": "개인정보에는 내부 관리계획·접속기록 보관 등 기술적·관리적·물리적 안전조치가 필요해요. 구체적인 접근권한·암호화·보관 설정은 시행령과 기관 보안 기준을 확인해야 하며 이 조문만으로 세부 설정값을 정하지 않아요.",
            "requires": [
              "내부 관리계획 수립",
              "접속기록 보관",
              "기술적ㆍ관리적 및 물리적 조치"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "privacy-leak",
    "title": "개인정보 오발송·유출",
    "sources": [
      "office-privacy-art34"
    ],
    "branches": [
      {
        "label": "즉시 대응 담당자와 함께 확인해요",
        "items": [
          {
            "source": "office-privacy-art34",
            "text": "오발송·분실 등으로 유출이 의심되면 기관 개인정보 담당자에게 즉시 상황을 알리고 대응을 시작해요. 유출된 개인정보의 회수·삭제 등 피해 확산을 막는 조치를 검토해요.",
            "requires": [
              "회수ㆍ삭제 등 피해 확산을 방지하기 위한 조치",
              "피해를 최소화하기 위한 대책"
            ]
          },
          {
            "source": "office-privacy-art34",
            "text": "정보주체 통지와 보호위원회 등 신고는 구분해 확인해요. 통지·신고 대상과 시기·방법의 세부 요건은 시행령에 위임되어 있으므로, 이 자료만 보고 일률적인 시간이나 신고 대상 여부를 확정하지 않아요.",
            "requires": [
              "지체 없이 해당 정보주체",
              "보호위원회 또는 대통령령으로 정하는 전문기관에 신고",
              "시기, 방법, 절차 등에 필요한 사항은 대통령령"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "records-register",
    "title": "업무자료 등록",
    "sources": [
      "office-public-records-3",
      "office-public-records-18"
    ],
    "branches": [
      {
        "label": "파일 형식보다 업무 관련성을 확인해요",
        "items": [
          {
            "source": "office-public-records-3",
            "text": "공공기관이 업무와 관련해 생산·접수한 문서와 전자문서 등 모든 형태의 기록정보 자료가 기록물의 범위에 들어가요. 이메일·메신저 자료도 업무 관련 기록물인지 확인하고, 모든 개인 대화를 일괄 등록한다고 단정하지 않아요.",
            "requires": [
              "업무와 관련하여 생산하거나 접수한",
              "전자문서 등 모든 형태의 기록정보 자료"
            ]
          },
          {
            "source": "office-public-records-18",
            "text": "업무상 기록물을 생산·접수했다면 등록·분류·편철에 필요한 조치를 확인해요. 실제 등록 방법과 예외는 시행령·기관 기록관리 절차에 따라 담당자와 확인해요.",
            "requires": [
              "생산하거나 접수하였을 때",
              "등록ㆍ분류ㆍ편철",
              "다만, 기록물의 특성상"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "records-meeting",
    "title": "회의록 작성",
    "sources": [
      "office-public-records-17",
      "office-public-records-16"
    ],
    "branches": [
      {
        "label": "모든 회의를 같은 기준으로 보지 않아요",
        "items": [
          {
            "source": "office-public-records-17",
            "text": "법은 대통령령으로 정하는 주요 회의의 회의록·속기록·녹음기록 작성을 규정해요. 이 조문만으로 모든 회의가 의무 대상이라고 답하지 않고, 시행령과 기관 기준에서 해당 회의가 대상인지 확인해요.",
            "requires": [
              "대통령령으로 정하는 바에 따라 주요 회의의 회의록, 속기록 또는 녹음기록"
            ]
          },
          {
            "source": "office-public-records-16",
            "text": "업무 과정과 결과가 기록으로 남도록 관리하는 원칙도 함께 확인해요. 실무 준비로 결정사항·담당자·후속 기한을 정리하면 좋지만, 이를 모든 회의의 법정 서식이라고 보지는 않아요.",
            "requires": [
              "업무수행의 모든 과정 및 결과",
              "업무과정에 기반한 기록물관리"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "records-disposal",
    "title": "기록물 폐기",
    "sources": [
      "office-public-records-27",
      "office-public-records-19"
    ],
    "branches": [
      {
        "label": "보존기간 경과만으로 직접 지우지 않아요",
        "items": [
          {
            "source": "office-public-records-27",
            "text": "기록물 폐기는 기록물관리 전문요원의 심사와 기록물평가심의회의 심의 등 정해진 절차를 거쳐야 해요. 보존기간이 지났다는 이유만으로 담당자가 임의로 삭제하지 말고 기록관리 담당자에게 확인해요.",
            "requires": [
              "기록물관리 전문요원의 심사",
              "기록물평가심의회의 심의"
            ]
          },
          {
            "source": "office-public-records-19",
            "text": "먼저 해당 기록물의 보존기간·접근권한 등 관리 기준을 확인해요. 개인 PC 정리와 공식 기록물 폐기는 구분해서 처리해요.",
            "requires": [
              "기록물의 보존기간, 공개 여부, 비밀 여부 및 접근권한"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "records-retention",
    "title": "기록물 보존기간·이관",
    "sources": [
      "office-public-records-19"
    ],
    "branches": [
      {
        "label": "모든 자료에 같은 기간을 적용하지 않아요",
        "items": [
          {
            "source": "office-public-records-19",
            "text": "기록물은 보존기간·공개 여부·접근권한 등을 분류해 관리하고 정해진 절차에 따라 이관해요. 특정 자료를 몇 년 보관할지는 이 조문만으로 정할 수 없으므로 기관 기록관리기준표와 해당 업무 기준을 확인해요.",
            "requires": [
              "기록물의 보존기간, 공개 여부, 비밀 여부 및 접근권한",
              "관할 기록관 또는 특수기록관으로 이관"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "disclosure-deadline",
    "title": "정보공개 청구 기한",
    "sources": [
      "office-disclosure-11",
      "office-disclosure-13"
    ],
    "branches": [
      {
        "label": "기한 · 청구와 결정 단계를 구분해요",
        "items": [
          {
            "source": "office-disclosure-11",
            "text": "공개 여부 결정은 청구를 받은 날부터 10일 이내가 원칙이에요. 부득이한 사유가 있을 때만 법이 정한 범위에서 10일까지 연장할 수 있고, 연장 사실과 사유를 지체 없이 문서로 통지해야 해요. 처음부터 무조건 20일로 잡지 않아요.",
            "requires": [
              "청구를 받은 날부터 10일 이내",
              "부득이한 사유",
              "10일의 범위",
              "연장된 사실과 연장 사유"
            ]
          },
          {
            "source": "office-disclosure-13",
            "text": "공개를 결정하면 일시·장소 등을 통지하고, 비공개 결정은 근거·이유·불복 절차를 밝혀 통지해요. 결정 기한과 실제 자료 제공 일시는 구분하고, 구체적 날짜 계산은 접수일·기간 계산 규정을 확인해요.",
            "requires": [
              "공개의 일시 및 장소",
              "비공개 이유와 불복",
              "지체 없이 문서로 통지"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "disclosure-transfer",
    "title": "다른 기관 정보 청구",
    "sources": [
      "office-disclosure-11"
    ],
    "branches": [
      {
        "label": "소관 기관과 청구인 통지를 확인해요",
        "items": [
          {
            "source": "office-disclosure-11",
            "text": "다른 공공기관이 보유·관리하는 정보의 청구라면 지체 없이 소관 기관으로 이송하고, 이송 후 소관 기관과 사유 등을 청구인에게 문서로 통지해요. 우리 기관에 없다는 이유만으로 모두 같은 방식으로 종결하지 않아요.",
            "requires": [
              "다른 공공기관이 보유ㆍ관리",
              "소관 기관으로 이송",
              "청구인에게 문서로 통지"
            ]
          },
          {
            "source": "office-disclosure-11",
            "text": "보유·관리하지 않는 정보나 진정·질의 성격의 청구는 법에서 정한 조건에 따라 민원으로 처리할 수 있는 경우도 있어요. 실제 보유 기관·청구 내용을 담당자가 확인해야 해요.",
            "requires": [
              "민원으로 처리할 수 있는 경우",
              "공공기관이 보유ㆍ관리하지 아니하는 정보"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "disclosure-third-party",
    "title": "제3자 관련 정보공개",
    "sources": [
      "office-disclosure-11"
    ],
    "branches": [
      {
        "label": "제3자 관련 절차를 확인해요",
        "items": [
          {
            "source": "office-disclosure-11",
            "text": "공개 청구 정보가 제3자와 관련 있다고 인정하면 그 사실을 제3자에게 지체 없이 통지하고, 필요한 경우 의견을 들을 수 있어요. 관련자라는 이유만으로 공개·비공개를 자동 확정하지 않아요.",
            "requires": [
              "제3자와 관련",
              "제3자에게 지체 없이 통지",
              "필요한 경우에는 그의 의견"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "disclosure-partial",
    "title": "개인정보가 섞인 공개 자료",
    "sources": [
      "office-disclosure-9",
      "office-disclosure-14"
    ],
    "branches": [
      {
        "label": "개인정보가 있다는 이유로 전부 비공개하지 않아요",
        "items": [
          {
            "source": "office-disclosure-9",
            "text": "개인정보가 포함되어 있어도 법의 비공개 요건과 예외를 구체적으로 검토해야 해요. 직무를 수행한 공무원의 성명·직위 등 예외도 있으므로 개인정보라는 이름만으로 일괄 비공개하지 않아요.",
            "requires": [
              "사생활의 비밀 또는 자유를 침해할 우려",
              "다만, 다음 각 목",
              "직무를 수행한 공무원의 성명ㆍ직위"
            ]
          },
          {
            "source": "office-disclosure-14",
            "text": "비공개 부분과 공개 가능한 부분을 청구 취지에 어긋나지 않게 분리할 수 있다면, 비공개 부분을 제외하고 공개해야 해요. 가릴 범위와 최종 결정은 권한 있는 담당자가 확인해요.",
            "requires": [
              "공개 청구의 취지에 어긋나지 아니하는 범위",
              "두 부분을 분리할 수 있는 경우",
              "부분을 제외하고 공개"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "disclosure-objection",
    "title": "정보공개 이의신청",
    "sources": [
      "office-disclosure-18"
    ],
    "branches": [
      {
        "label": "기한 · 신청 기한과 기관 결정 기한을 나눠 봐요",
        "items": [
          {
            "source": "office-disclosure-18",
            "text": "청구인은 비공개·부분공개 결정이나 청구 후 20일이 지나도 결정이 없는 경우 등 법이 정한 사유에 따라 이의신청을 할 수 있어요. 신청 기한은 결정 통지일 또는 청구 후 20일 경과일을 기준으로 30일 이내인지 확인해요.",
            "requires": [
              "비공개 결정 또는 부분 공개 결정",
              "20일이 경과",
              "30일 이내"
            ]
          },
          {
            "source": "office-disclosure-18",
            "text": "기관은 이의신청을 받은 날부터 7일 이내에 결정하고 결과를 통지하는 것이 원칙이에요. 부득이한 사유가 있으면 법이 정한 범위에서 7일까지 연장하고 사유를 통지해야 해요.",
            "requires": [
              "이의신청을 받은 날부터 7일 이내",
              "부득이한 사유",
              "7일의 범위에서 연장",
              "연장 사유를 청구인에게 통지"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "handover-checklist",
    "title": "업무 인수인계",
    "sources": [
      "office-administration-61",
      "office-administration-rules-46"
    ],
    "branches": [
      {
        "label": "행정기관 기준 · 자료와 진행 상황을 함께 넘겨요",
        "items": [
          {
            "source": "office-administration-61",
            "text": "조직개편·인사발령·업무분장 변경으로 인계인수할 때는 업무의 모든 사항이 구체적으로 드러나도록 업무관리시스템·전자문서시스템을 이용하는 기준을 확인해요. 구체적 인계 서식과 절차는 시행규칙·기관 기준을 추가 확인해요.",
            "requires": [
              "조직개편, 인사발령 또는 업무분장 조정",
              "모든 사항이 구체적으로",
              "업무관리시스템이나 전자문서시스템"
            ]
          },
          {
            "source": "office-administration-rules-46",
            "text": "직무편람에는 업무 연혁·현황·계획, 처리절차·흐름도, 보존문서 현황과 참고사항을 담고 인계인수 때 함께 넘겨요.",
            "requires": [
              "업무의 처리절차 및 흐름도",
              "소관 보존문서 현황",
              "직무편람을 함께 인계ㆍ인수"
            ]
          },
          {
            "source": "office-administration-rules-46",
            "text": "실무 준비로 미처리 업무·마감·다음 조치·관련 자료 위치를 정리해 보세요. 이는 편람의 현황·절차·참고사항을 채우기 위한 앱의 점검 제안이며, 계정 비밀번호를 공유하라는 뜻은 아니에요.",
            "requires": [
              "관련 업무 현황",
              "업무의 처리절차",
              "참고사항"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "handover-manual",
    "title": "업무편람 갱신",
    "sources": [
      "office-administration-62",
      "office-administration-rules-46"
    ],
    "branches": [
      {
        "label": "행정기관 기준 · 만들고 계속 보완해요",
        "items": [
          {
            "source": "office-administration-62",
            "text": "반복 업무는 표준화·전문화를 위해 업무편람을 작성·활용하는 것이 원칙이에요. 절차·기준을 설명하는 행정편람과 업무 현황·계획 등을 정리하는 직무편람을 구분해요.",
            "requires": [
              "상당 기간에 걸쳐 반복적으로 하는 업무",
              "행정편람과 직무편람"
            ]
          },
          {
            "source": "office-administration-rules-46",
            "text": "직무편람은 정기적·수시로 수정·보완하고 인계인수 때 함께 넘겨요. 한 번 만들고 끝나는 자료로 두지 않아요.",
            "requires": [
              "정기적으로 또는 수시로 그 내용을 수정하거나 보완",
              "직무편람을 함께 인계ㆍ인수"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "privacy-sensitive",
    "title": "민감정보 수집",
    "sources": [
      "office-privacy-art23"
    ],
    "branches": [
      {
        "label": "일반 개인정보 수집 근거와 구분해요",
        "items": [
          {
            "source": "office-privacy-art23",
            "text": "건강·병력 등 민감정보는 일반 개인정보 수집 근거만으로 처리할 수 있다고 답하지 않아요. 법에서 정한 사항을 알리고 다른 개인정보 처리 동의와 별도로 동의를 받거나, 법령에서 처리를 요구·허용하는 등 제23조의 예외인지 확인해야 해요.",
            "requires": [
              "건강",
              "다른 개인정보의 처리에 대한 동의와 별도로 동의",
              "법령에서 민감정보의 처리를 요구하거나 허용"
            ]
          },
          {
            "source": "office-privacy-art23",
            "text": "적법하게 민감정보를 처리하는 경우에도 분실·도난·유출 등을 막는 안전조치가 필요해요. 실제 자료 항목과 처리 목적을 기관 담당자와 확인해요.",
            "requires": [
              "제29조에 따른 안전성 확보에 필요한 조치"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "disclosure-third-objection",
    "title": "정보공개 제3자의 비공개 요청·불복",
    "sources": [
      "office-disclosure-21"
    ],
    "branches": [
      {
        "label": "기한 · 청구인의 이의신청과 구분해요",
        "items": [
          {
            "source": "office-disclosure-21",
            "text": "공개 청구 사실을 통지받은 제3자는 통지를 받은 날부터 3일 이내에 관련 정보를 공개하지 말라고 요청할 수 있어요. 이는 일반 청구인의 이의신청과 다른 절차예요.",
            "requires": [
              "통지를 받은 날부터 3일 이내",
              "공개하지 아니할 것을 요청"
            ]
          },
          {
            "source": "office-disclosure-21",
            "text": "비공개 요청에도 기관이 공개를 결정했다면 제3자에게 이유와 공개 실시일을 문서로 통지해야 해요. 이 경우 제3자의 이의신청은 통지를 받은 날부터 7일 이내이며, 공개 결정일과 공개 실시일 사이에는 최소 30일의 간격을 두어야 해요.",
            "requires": [
              "통지를 받은 날부터 7일 이내",
              "최소한 30일의 간격"
            ]
          }
        ]
      }
    ]
  }
]