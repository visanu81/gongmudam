[
  {
    "id": "bonus-timing-both",
    "sources": [
      "office-bonus-n552",
      "office-bonus-l476",
      "office-bonus-n553",
      "office-bonus-l447",
      "office-bonus-n509",
      "office-bonus-l430"
    ],
    "branches": [
      {
        "label": "지급 시기",
        "items": [
          {
            "source": "office-bonus-n552",
            "text": "국가공무원은 소속 장관이 2월 말까지 자체 지급계획을 세우고 성과급운영위원회 심의로 확정해요. 지급횟수와 지급시기가 이 계획에 들어가요.",
            "requires": [
              "소속장관은 2월말까지",
              "자체 지급계획을 수립",
              "심의를 거쳐 확정한다",
              "지급횟수, 지급시기"
            ]
          },
          {
            "source": "office-bonus-l476",
            "text": "지방공무원은 지방자치단체의 장과 지방의회 의장이 2월 말까지 자체 지급계획을 세우고 성과급운영위원회 심의로 확정해요. 지급횟수와 지급시기가 이 계획에 들어가요.",
            "requires": [
              "지방의회의 의장은 2월말까지",
              "자체 지급계획을 수립",
              "심의를 거쳐 확정한다",
              "지급횟수, 지급시기"
            ]
          },
          {
            "source": "office-bonus-n552",
            "text": "국가는 평가와 이의신청 심의를 마친 뒤에 지급해요.",
            "requires": [
              "평가 및 이의신청에 대한 심의를 완료한 후에",
              "성과상여금을 지급한다"
            ]
          },
          {
            "source": "office-bonus-l476",
            "text": "지방은 평가와 이의신청 심사를 마친 뒤에 지급해요.",
            "requires": [
              "평가 및 이의신청에 대한 심사를 완료한 후에 성과상여금을 지급한다"
            ]
          },
          {
            "source": "office-bonus-l447",
            "text": "지방은 지급 전에 7일 이상 이의제기 기간을 두어야 해요.",
            "requires": [
              "성과상여금 지급전에 7일 이상의 이의제기기간을 두어야 한다"
            ]
          },
          {
            "source": "office-bonus-n553",
            "text": "국가 기관은 지급계획과 운영결과를 3월 말까지 인사혁신처장에게 내요. 부득이하게 지급이 늦어지면 지급을 마친 뒤 지연 사유와 함께 내요.",
            "requires": [
              "당해 연도 3월말까지 인사혁신처장에게 제출",
              "부득이하게 성과상여금 지급이 늦어지는 경우",
              "지연 사유와 함께"
            ]
          }
        ]
      },
      {
        "label": "지급기준일과 평가 기간",
        "items": [
          {
            "source": "office-bonus-n509",
            "text": "국가는 평가와 지급이 연 1회 이상이에요. 연 1회 평가하면 전년도 12월 31일을 지급기준일로 전년 1월 1일~12월 31일의 성과를 평가하는 것이 원칙이고, 소속 장관이 달리 정할 수 있어요. 연 2회 이상이면 각 평가대상기간의 마지막 날이 기준일이에요.",
            "requires": [
              "연 1회 이상",
              "전년도 12월 31일 현재를 지급기준일",
              "평가대상기간과 지급기준일을 달리 정할 수 있다",
              "각 평가대상기간의 마지막 날"
            ]
          },
          {
            "source": "office-bonus-l430",
            "text": "지방도 평가와 지급이 연 1회 이상이에요. 연 1회 평가하면 전년도 12월 31일을 지급기준일로 전년 1월 1일~12월 31일의 성과를 평가하는 것이 원칙이고, 지방자치단체의 장과 지방의회 의장이 달리 정할 수 있어요. 연 2회 이상이면 각 평가대상기간의 마지막 날이 기준일이에요.",
            "requires": [
              "연 1회 이상",
              "전년도 12월 31일 현재를 지급기준일",
              "평가대상기간과 지급 기준일을 달리 정할 수 있다",
              "각 평가대상기간의 마지막 날"
            ]
          }
        ]
      },
      {
        "label": "지급 방법",
        "items": [
          {
            "source": "office-bonus-n509",
            "text": "국가는 일시금 지급이 원칙이고, 소속 장관이 직원 의견수렴을 거쳐 몇 개월로 나누어 지급할 수 있어요.",
            "requires": [
              "일시금으로 지급하는 것을 원칙",
              "소속직원의 의견수렴 등을 거쳐 분할하여"
            ]
          },
          {
            "source": "office-bonus-l430",
            "text": "지방은 일시금 지급이 원칙이고, 직원 의견수렴을 거쳐 월별로 나누어 지급할 수 있어요.",
            "requires": [
              "일시금으로 지급하는 것을 원칙",
              "의견수렴 등을 거쳐",
              "월별 분할하여 지급할 수 있다"
            ]
          },
          {
            "source": "office-bonus-l447",
            "text": "지방에서 매월 분할하면 연 1회 평가는 그해 남은 달로, 연 2회 평가는 상반기 6월까지·하반기 12월까지 나누어 지급해요.",
            "requires": [
              "매월 분할하여",
              "연 1회 평가 시 해당연도 잔여월로 분할",
              "상반기는 해당연도 6월까지, 하반기는 12월까지"
            ]
          }
        ]
      }
    ]
  },
