[
  {
    "id": "goods-national-inventory",
    "sources": [
      "office-goods-national-act-2",
      "office-goods-national-act-4",
      "office-goods-national-act-19",
      "office-goods-national-decree-22",
      "office-goods-national-rule-27"
    ],
    "branches": [
      {
        "label": "적용 대상",
        "items": [
          {
            "source": "office-goods-national-act-2",
            "text": "국가 소유 또는 국가가 사용하기 위해 보관하는 동산의 기준이에요. 현금 등 법에서 제외한 대상은 별도로 확인해요.",
            "requires": [
              "국가가 소유하는 동산",
              "다음 각 호의 동산은 제외"
            ]
          },
          {
            "source": "office-goods-national-act-4",
            "text": "다른 법률에 특별한 물품관리 규정이 있으면 그 규정을 먼저 확인해요.",
            "requires": [
              "다른 법률에 특별한 규정이 있는 경우 외에는"
            ]
          }
        ]
      },
      {
        "label": "조사 주기와 기한",
        "items": [
          {
            "source": "office-goods-national-act-19",
            "text": "정기재물조사는 연 1회예요. 필요하면 수시조사도 할 수 있어요.",
            "requires": [
              "연 1회",
              "수시로 재물조사"
            ]
          },
          {
            "source": "office-goods-national-decree-22",
            "text": "조달청 정기재물조사지침에 따라 매년 12월 31일 기준으로 조사하고, 다음 해 2월 말일까지 보고서를 조달청장에게 제출해요. 디지털예산·회계시스템 게재로 제출을 갈음할 수 있어요.",
            "requires": [
              "매년 12월 31일을 기준",
              "다음 연도 2월 말일까지",
              "게재함으로써 그 제출을 갈음"
            ]
          },
          {
            "source": "office-goods-national-decree-22",
            "text": "보고서 보완 요청을 받았다면 해당 연도 3월 15일까지 보완해야 해요.",
            "requires": [
              "보완 요청을 받은 중앙관서의 장",
              "해당 연도 3월 15일까지"
            ]
          }
        ]
      },
      {
        "label": "조사 준비",
        "items": [
          {
            "source": "office-goods-national-rule-27",
            "text": "보고서 서식은 조달청장이 정해요. 물품관리관이나 물품출납공무원이 교체되었을 때도 재물조사를 실시하게 해야 해요.",
            "requires": [
              "보고서의 서식은 조달청장이 정한다",
              "물품관리관이나 물품출납공무원이 교체"
            ]
          },
          {
            "source": "office-goods-national-rule-27",
            "text": "물품관리에 직접 관련되지 않은 공무원을 조사요원으로 임명하고 별표 1의 상태 분류기준을 확인해요.",
            "requires": [
              "물품관리에 직접 관련되지 않은 공무원",
              "별표 1의 물품상태 분류기준"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "goods-local-inventory",
    "sources": [
      "office-goods-local-act-2",
      "office-goods-local-decree-91",
      "office-goods-local-act-60",
      "office-goods-local-decree-59"
    ],
    "branches": [
      {
        "label": "적용 대상",
        "items": [
          {
            "source": "office-goods-local-act-2",
            "text": "지방자치단체 소유 또는 사용을 위해 보관하는 동산의 기준이에요. 현금·유가증권·공유재산은 이 물품 정의에서 제외돼요.",
            "requires": [
              "지방자치단체가 소유하는 동산",
              "가. 현금",
              "나. 유가증권",
              "다. 제4조에 따른 공유재산"
            ]
          },
          {
            "source": "office-goods-local-decree-91",
            "text": "미술품·도서·소프트웨어·리스 물품 등에는 일부 조문을 적용하지 않을 수 있어요. 이런 물품은 특성에 맞는 별도 관리기준을 먼저 확인해요.",
            "requires": [
              "적용하지 않을 수 있다",
              "11. 소프트웨어",
              "12. 리스 물품",
              "그 물품의 특성을 고려"
            ]
          }
        ]
      },
      {
        "label": "조사 주기",
        "items": [
          {
            "source": "office-goods-local-act-60",
            "text": "현행 지자체 기준은 1년마다 재물조사예요. 필요하면 수시조사도 할 수 있어요.",
            "requires": [
              "1년마다 재물조사",
              "수시로 재물조사"
            ]
          },
          {
            "source": "office-goods-local-act-60",
            "text": "조사에서 분실·훼손 물품을 찾으면 회계관계직원 등의 책임에 관한 법률에 따라 조치해야 해요. 개인의 배상책임을 이 답변만으로 확정하지는 않아요.",
            "requires": [
              "잃어버리거나 훼손된 물품",
              "「회계관계직원 등의 책임에 관한 법률」에 따라"
            ]
          }
        ]
      },
      {
        "label": "지침과 보고 경로",
        "items": [
          {
            "source": "office-goods-local-decree-59",
            "text": "행정안전부장관이 정하는 재물조사지침을 따라요. 국가기관의 12월 31일 기준일·2월 말 제출기한을 이 조문만으로 지자체에 그대로 적용하지 않아요. 해당 연도 지침과 기관 일정을 추가로 확인해요.",
            "requires": [
              "행정안전부장관이 정하는 재물조사지침에 따라야 한다"
            ]
          },
          {
            "source": "office-goods-local-decree-59",
            "text": "결과는 행정안전부장관에게 제출해요. 시장·군수·자치구청장은 특별시장·통합특별시장·광역시장·도지사 또는 특별자치도지사를 거쳐 제출해요.",
            "requires": [
              "그 결과를 행정안전부장관에게 제출",
              "거쳐서 제출해야 한다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "goods-national-ledger",
    "sources": [
      "office-goods-national-act-2",
      "office-goods-national-act-4",
      "office-goods-national-act-24",
      "office-goods-national-rule-35"
    ],
    "branches": [
      {
        "label": "적용 대상",
        "items": [
          {
            "source": "office-goods-national-act-2",
            "text": "국가 소유 또는 국가가 사용하기 위해 보관하는 동산의 기준이에요. 현금 등 법에서 제외한 대상은 별도로 확인해요.",
            "requires": [
              "국가가 소유하는 동산",
              "다음 각 호의 동산은 제외"
            ]
          },
          {
            "source": "office-goods-national-act-4",
            "text": "다른 법률에 특별한 물품관리 규정이 있으면 그 규정을 먼저 확인해요.",
            "requires": [
              "다른 법률에 특별한 규정이 있는 경우 외에는"
            ]
          }
        ]
      },
      {
        "label": "기록·서식 관리",
        "items": [
          {
            "source": "office-goods-national-act-24",
            "text": "물품관리관·물품운용관·물품출납공무원은 표준서식에 물품관리 사항을 기록하고 유지해야 해요.",
            "requires": [
              "표준서식",
              "물품관리에 필요한 사항을 기록ㆍ유지"
            ]
          },
          {
            "source": "office-goods-national-rule-35",
            "text": "표준서식은 시행규칙 별지 제8~11호, 제11호의2, 제12호예요. 다른 서식이나 변경한 서식을 쓰려면 중앙관서의 장이 미리 조달청장과 협의해야 해요. 실제 필수 입력 칸은 해당 별지 원문을 추가로 확인해야 해요.",
            "requires": [
              "별지 제8호서식부터 별지 제11호서식까지",
              "별지 제11호의2서식 및 별지 제12호서식",
              "미리 조달청장과 협의"
            ]
          },
          {
            "source": "office-goods-national-rule-35",
            "text": "전산파일로 표준서식을 작성하면 매월 말일 기준으로 그 달의 증감 현황과 실제가 맞는지 확인해요. 법령에서 정한 디지털예산·회계시스템으로 관리하면 표준서식을 쓴 것으로 봐요.",
            "requires": [
              "매월 말일을 기준",
              "해당 월의 물품 증감 현황이 실제와 맞는지",
              "표준서식을 사용한 것으로 본다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "goods-national-disposal",
    "sources": [
      "office-goods-national-act-2",
      "office-goods-national-act-4",
      "office-goods-national-act-35",
      "office-goods-national-rule-51",
      "office-goods-national-decree-40",
      "office-goods-national-rule-52",
      "office-goods-national-rule-57",
      "office-goods-national-rule-58",
      "office-goods-national-rule-34"
    ],
    "branches": [
      {
        "label": "적용 대상",
        "items": [
          {
            "source": "office-goods-national-act-2",
            "text": "국가 소유 또는 국가가 사용하기 위해 보관하는 동산의 기준이에요. 현금 등 법에서 제외한 대상은 별도로 확인해요.",
            "requires": [
              "국가가 소유하는 동산",
              "다음 각 호의 동산은 제외"
            ]
          },
          {
            "source": "office-goods-national-act-4",
            "text": "다른 법률에 특별한 물품관리 규정이 있으면 그 규정을 먼저 확인해요.",
            "requires": [
              "다른 법률에 특별한 규정이 있는 경우 외에는"
            ]
          }
        ]
      },
      {
        "label": "1. 불용 사유와 승인 확인",
        "items": [
          {
            "source": "office-goods-national-act-35",
            "text": "사용할 필요가 없거나 사용할 수 없는 물품은 물품관리관이 불용결정해요. 불용결정만으로 곧바로 폐기할 수 있는 것은 아니에요.",
            "requires": [
              "사용할 필요가 없거나 사용할 수 없는",
              "매각하기에 부적당하거나 매각하면 국가에 불리",
              "매각할 수 없는 경우에는 폐기"
            ]
          },
          {
            "source": "office-goods-national-rule-51",
            "text": "불용 사유에는 앞으로 쓸 전망이 없는 물품, 수요·정수 초과, 수리해도 원래 목적에 쓸 수 없는 물품, 수선이 비경제적인 물품 등이 있어요. 실제 상태가 어느 사유에 해당하는지 확인해요.",
            "requires": [
              "앞으로도 사용할 전망이 없는",
              "수선을 하는 것이 비경제적인"
            ]
          },
          {
            "source": "office-goods-national-decree-40",
            "text": "취득단가 500만원 이상이면서 활용 가능한 물품의 불용결정은 중앙관서장 승인이 필요해요. 폐기는 취득단가 500만원 이상이면 승인이 필요하므로 두 조건을 구분해요.",
            "requires": [
              "취득단가가 500만원 이상으로서 활용이 가능한",
              "승인을 받아 폐기하는 물품은 취득단가가 500만원 이상"
            ]
          }
        ]
      },
      {
        "label": "해체·폐기 전 인도 절차",
        "items": [
          {
            "source": "office-goods-national-rule-34",
            "text": "제57조가 준용하는 절차에 따라 보관 중인 물품은 출납공무원에게 출급명령을, 사용 중인 물품은 운용관에게 반납명령을 해요. 반납명령 때는 인도받을 자를 명확히 한 인도명령도 필요해요.",
            "requires": [
              "물품출납공무원에게는 물품의 출급명령",
              "물품운용관에게는 물품의 반납명령",
              "인도받을 자를 명백히",
              "물품의 인도명령"
            ]
          }
        ]
      },
      {
        "label": "2. 처분 방법과 서류",
        "items": [
          {
            "source": "office-goods-national-rule-51",
            "text": "폐기 대상은 관리전환·양여·매각·교환을 하려 해도 처분되지 않는 물품, 또는 변질·부패 등으로 매각할 수 없다고 인정되는 물품이에요.",
            "requires": [
              "관리전환, 양여, 매각, 교환의 방법으로 처분을 하려고 해도 처분되지",
              "변질ㆍ부패 또는 그 밖의 사유로 매각할 수 없다고"
            ]
          },
          {
            "source": "office-goods-national-rule-52",
            "text": "불용결정은 별지 제17호의3서식의 불용 결정(승인요청)서로 해요. 실제 서식 파일은 추가 등록이 필요해요.",
            "requires": [
              "별지 제17호의3서식의 불용 결정(승인요청)서"
            ]
          },
          {
            "source": "office-goods-national-rule-57",
            "text": "해체·폐기는 별지 제17호의4서식의 조서를 작성하고 관련 자료를 붙여요. 같은 조 제3항이 준용하는 제34조의 절차도 실행 전에 확인해야 해요.",
            "requires": [
              "별지 제17호의4서식",
              "관련된 자료를 첨부",
              "제34조제1항 및 제2항을 준용"
            ]
          }
        ]
      },
      {
        "label": "3. 장부에 남기기",
        "items": [
          {
            "source": "office-goods-national-rule-58",
            "text": "불용결정 때는 결정일·물품 상태를, 처분 후에는 처분 구분·날짜·금액과 해체로 얻은 부분품 명세를 장부 등에 기록해요.",
            "requires": [
              "불용결정 연월일",
              "처분의 구분",
              "처분연월일",
              "처분금액",
              "부분품의 명세표"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "goods-local-disposal",
    "sources": [
      "office-goods-local-act-2",
      "office-goods-local-decree-91",
      "office-goods-local-act-75",
      "office-goods-local-decree-77",
      "office-goods-local-decree-76"
    ],
    "branches": [
      {
        "label": "적용 대상",
        "items": [
          {
            "source": "office-goods-local-act-2",
            "text": "지방자치단체 소유 또는 사용을 위해 보관하는 동산의 기준이에요. 현금·유가증권·공유재산은 이 물품 정의에서 제외돼요.",
            "requires": [
              "지방자치단체가 소유하는 동산",
              "가. 현금",
              "나. 유가증권",
              "다. 제4조에 따른 공유재산"
            ]
          },
          {
            "source": "office-goods-local-decree-91",
            "text": "미술품·도서·소프트웨어·리스 물품 등에는 일부 조문을 적용하지 않을 수 있어요. 이런 물품은 특성에 맞는 별도 관리기준을 먼저 확인해요.",
            "requires": [
              "적용하지 않을 수 있다",
              "11. 소프트웨어",
              "12. 리스 물품",
              "그 물품의 특성을 고려"
            ]
          }
        ]
      },
      {
        "label": "불용결정과 폐기",
        "items": [
          {
            "source": "office-goods-local-act-75",
            "text": "사용할 필요가 없거나 쓸 수 없는 물품은 지자체장이 불용결정해요. 대통령령에서 정한 물품은 물품관리관이 결정할 수 있어요.",
            "requires": [
              "사용할 필요가 없거나 사용할 수 없는",
              "대통령령으로 정하는 물품은 물품관리관"
            ]
          },
          {
            "source": "office-goods-local-decree-77",
