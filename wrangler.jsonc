{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gongmudam",
  "account_id": "bf848c0112a24bf78192b5b721290ded",
  "main": "cloudflare/index.js",
  "compatibility_date": "2026-10-24",
  "workers_dev": true,
  "assets": {
    "directory": ".wrangler/web-assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The public demo runs in one container built by tools/stage_container.py.
  "containers": [{
    "class_name": "GongmudamDemo",
    "image": "./work/container-stage/Dockerfile",
    "instance_type": "basic",
    "max_instances": 1
  }],
  "durable_objects": {
    "bindings": [{"name": "DEMO", "class_name": "GongmudamDemo"}]
  },
  "exports": {
    "GongmudamDemo": {"type": "durable-object", "storage": "sqlite"}
  },
  "observability": {"enabled": false}
}
