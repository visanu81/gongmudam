[
  {
    "id": "documents-receipt",
    "sources": [
      "office-documents-decree-2",
      "office-documents-decree-3",
      "office-documents-decree-18",
      "office-documents-rule-15"
    ],
    "branches": [
      {
        "label": "1. 받은 곳과 담당 구분",
        "items": [
          {
            "source": "office-documents-decree-2",
            "text": "중앙행정기관·소속기관, 지방자치단체 기관과 군 기관의 공통 기준이에요. 다른 법령에 특별한 규정이 있으면 그 기준을 먼저 확인해요.",
            "requires": [
              "중앙행정기관",
              "지방자치단체의 기관과 군",
              "다른 법령에 특별한 규정이 있는 경우를 제외"
            ]
          },
          {
            "source": "office-documents-decree-3",
            "text": "문서과는 문서 분류·배부 등을 주관하고, 처리과는 해당 업무 처리를 주관해요. 실제 어느 부서인지는 기관 업무분장으로 확인해요.",
            "requires": [
              "“문서과”란",
              "“처리과”란 업무 처리를 주관"
            ]
          }
        ]
      },
      {
        "label": "2. 접수 · 배부 · 담당자 인계",
        "items": [
          {
            "source": "office-documents-decree-18",
            "text": "문서는 처리과에서 접수하고 접수일시·접수등록번호를 표시해요. 종이문서는 접수인을 찍고 일시·번호를 적어요.",
            "requires": [
              "문서는 처리과에서 접수",
              "접수일시와 접수등록번호를 적는다"
            ]
          },
          {
            "source": "office-documents-decree-18",
            "text": "문서과가 받았다면 접수일시를 남기고 지체 없이 처리과에 배부해요. 처리과는 배부받은 문서에 접수등록번호를 표시하고, 수신 업무 담당자는 처리담당자에게 인계해요.",
            "requires": [
              "지체 없이 처리과에 배부",
              "접수한 문서를 처리담당자에게 인계"
            ]
          },
          {
            "source": "office-documents-decree-18",
            "text": "접수·배부 경로도 등록정보로 관리해요. 기관별 정확한 담당자나 시스템 메뉴는 별도 자료로 확인해요.",
            "requires": [
              "문서의 접수 및 배부 경로에 관한 정보"
            ]
          }
        ]
      },
      {
        "label": "3. 여러 부서 관련 · 당직 접수",
        "items": [
          {
            "source": "office-documents-rule-15",
            "text": "여러 부서와 관련되면 관련성이 가장 높은 부서가 처리과로 접수하고, 관련된 다른 부서에도 내용을 통보해요.",
            "requires": [
              "관련성이 가장 높은 보조기관 또는 보좌기관",
              "접수한 문서의 내용을 통보"
            ]
          },
          {
            "source": "office-documents-rule-15",
            "text": "당직근무자가 받은 문서는 다음 근무시간 시작 후 지체 없이 문서과에 인계해요.",
            "requires": [
              "다음 근무시간 시작 후 지체 없이 문서과에 인계"
            ]
          }
        ]
      },
      {
        "label": "4. 기한 · 공람 확인",
        "items": [
          {
            "source": "office-documents-decree-18",
            "text": "공통 조문은 문서과의 배부를 “지체 없이”라고 정해요. 기관별 배부 시각이나 회신 마감은 내부 기준·문서 지시를 추가로 확인해요.",
            "requires": [
              "지체 없이 처리과에 배부",
              "문서의 처리기한과 처리방법을 지시"
            ]
          },
          {
            "source": "office-documents-decree-18",
            "text": "정해진 문서는 처리담당자가 공람 범위를 정해 공람할 수 있어요. 공람하는 결재권자는 처리기한·방법을 지시하거나 필요하면 담당자를 따로 지정할 수 있어요.",
            "requires": [
              "그 문서를 공람하게 할 수 있다",
              "처리담당자를 따로 지정할 수 있다"
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "documents-drafting",
    "sources": [
      "office-documents-decree-2",
      "office-documents-decree-8",
      "office-documents-decree-9",
      "office-documents-decree-10",
      "office-documents-decree-6",
      "office-documents-decree-11",
      "office-documents-decree-12"
    ],
    "branches": [
      {
        "label": "1. 적용 확인 · 기안",
        "items": [
          {
            "source": "office-documents-decree-2",
            "text": "중앙행정기관·소속기관, 지방자치단체 기관과 군 기관의 공통 기준이에요. 다른 법령에 특별한 규정이 있으면 그 기준을 먼저 확인해요.",
            "requires": [
              "중앙행정기관",
              "지방자치단체의 기관과 군",
              "다른 법령에 특별한 규정이 있는 경우를 제외"
            ]
          },
          {
            "source": "office-documents-decree-8",
            "text": "먼저 기안해요. 전자문서가 원칙이며, 업무 성질상 곤란하거나 특별한 사정이 있으면 예외가 있어요. 정해진 기안문을 사용하되 관계 서식이 따로 있으면 그 서식에 적을 수 있어요.",
            "requires": [
              "전자문서로 하는 것을 원칙",
              "업무의 성질상 전자문서로 기안하기 곤란",
              "관계 서식이 따로 있는 경우"
            ]
          }
        ]
      },
      {
        "label": "2. 결재 전 검토 · 관련 부서 협조",
        "items": [
          {
            "source": "office-documents-decree-9",
            "text": "결재를 받기 전에 보조·보좌기관의 검토를 받아요. 다른 부서 업무와 관련될 때는 협조도 받아야 해요. 모든 건에 같은 협조 결재선을 넣는다는 뜻은 아니에요.",
            "requires": [
              "결재권자의 결재를 받기 전에",
              "업무와 관련이 있을 때에는",
              "협조를 받아야 한다"
            ]
          },
          {
            "source": "office-documents-decree-9",
            "text": "출장 등으로 검토할 수 없는 부득이한 경우 검토를 생략할 수 있지만, 검토자 서명란에 그 사유를 적어야 해요.",
            "requires": [
              "부득이한 경우에는 검토를 생략",
              "검토자의 서명란에 출장 등의 사유를 적어야"
            ]
          }
        ]
      },
      {
        "label": "3. 권한 있는 사람의 결재",
        "items": [
          {
            "source": "office-documents-decree-10",
            "text": "기관장 결재가 기본이고, 보조·보좌기관 명의 문서는 해당 보조·보좌기관이 결재해요. 위임전결 사항은 기관장의 훈령이나 지자체 규칙으로 정하므로, 실제 결재권자·순서는 소속 기관의 사무전결 규칙을 확인해요.",
            "requires": [
              "해당 행정기관의 장의 결재",
              "보조기관 또는 보좌기관의 결재",
              "훈령이나 지방자치단체의 규칙"
            ]
          },
          {
            "source": "office-documents-decree-10",
            "text": "결재권자가 휴가·출장 등으로 결재할 수 없으면 직무를 대리하는 사람이 대결해요. 중요한 내용은 사후에 보고해야 해요.",
            "requires": [
              "그 직무를 대리하는 사람이 대결",
              "내용이 중요한 문서는 사후에 보고"
            ]
          }
        ]
      },
      {
        "label": "4. 성립 · 등록 · 발신",
        "items": [
          {
            "source": "office-documents-decree-6",
            "text": "결재권자가 서명 방식으로 결재하면 문서가 성립해요. 수신자에게 도달해 효력이 생기는 시점과는 구분해요. 공고문서는 별도 효력 규정도 확인해요.",
            "requires": [
              "결재함으로써 성립",
              "수신자에게 도달",
              "공고문서는"
            ]
          },
          {
            "source": "office-documents-decree-11",
            "text": "성립한 생산문서는 지체 없이 생산등록번호를 부여하고 등록해요.",
            "requires": [
              "문서가 성립된 경우",
              "지체 없이",
              "생산등록번호"
            ]
          },
          {
            "source": "office-documents-decree-12",
            "text": "결재받은 문서 중 발신할 문서는 시행문으로 작성해 발신해요. 내부에서만 처리하는 문서까지 무조건 발신하는 것은 아니에요.",
            "requires": [
              "결재를 받은 문서 가운데 발신하여야 하는 문서"
            ]
          }
        ]
      }
    ]
  }
]